{
  "name": "jianvideo-workspace",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "build": "turbo run build",
    "coverage": "turbo run coverage",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "format:check": "prettier --check \"apps/*/src/**/*.{js,jsx,ts,tsx,json,css,scss}\" \"apps/*/*.{js,cjs,mjs,ts,json,yml,yaml}\" \"packages/*/src/**/*.{js,jsx,ts,tsx,json,css,scss}\" \"packages/*/*.{js,cjs,mjs,ts,json,yml,yaml}\"",
    "frontend:build": "npm --prefix frontend run build",
    "frontend:coverage": "npm --prefix frontend run coverage",
    "frontend:format:check": "npm --prefix frontend run format:check",
    "frontend:lint": "npm --prefix frontend run lint",
    "frontend:test": "npm --prefix frontend run test",
    "frontend:test:coverage": "npm --prefix frontend run test:coverage",
    "frontend:typecheck": "npm --prefix frontend run typecheck",
    "go:coverage": "node --test scripts/go-coverage-policy.test.mjs && node scripts/go-coverage-gate.mjs",
    "go:lint": "golangci-lint run ./...",
    "go:test": "go test ./...",
    "go:vet": "go vet ./...",
    "go:vuln": "govulncheck ./...",
    "lint": "turbo run lint",
    "quality": "pnpm run quality:workspace && pnpm run quality:frontend && pnpm run quality:go && pnpm run quality:e2e && pnpm run quality:release",
    "quality:e2e": "node --test scripts/playwright-quality-reporter.test.mjs && playwright test --retries=0 --reporter=line,./scripts/playwright-quality-reporter.mjs",
    "quality:frontend": "pnpm run frontend:build && pnpm run frontend:typecheck && pnpm run frontend:lint && pnpm run frontend:format:check && pnpm run frontend:test:coverage",
    "quality:go": "pnpm run go:vet && pnpm run go:vuln && pnpm run go:coverage && pnpm run go:lint",
    "quality:release": "bash scripts/dev-version_test.sh && bash scripts/changelog-extract_test.sh && bash scripts/publish-release_test.sh && node --test scripts/release-workflow-contract.test.mjs",
    "quality:workspace": "pnpm run build && pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm run coverage",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck"
  },
  "dependencies": {
    "axios": "^1.18.0",
    "react-router-dom": "^7.18.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.56.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^3.2.6",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.1",
    "turbo": "^2.7.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vitest": "^3.2.6"
  }
}
