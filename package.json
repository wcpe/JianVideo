{
  "name": "jianvideo-workspace",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "build": "turbo run build",
    "coverage": "turbo run coverage",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "frontend:build": "npm --prefix frontend run build",
    "frontend:coverage": "npm --prefix frontend run coverage",
    "frontend:lint": "npm --prefix frontend run lint",
    "frontend:test": "npm --prefix frontend run test",
    "frontend:typecheck": "npm --prefix frontend run typecheck",
    "go:coverage": "node scripts/go-coverage-gate.mjs",
    "go:lint": "golangci-lint run ./...",
    "go:test": "go test ./...",
    "go:vet": "go vet ./...",
    "go:vuln": "govulncheck ./...",
    "lint": "turbo run lint",
    "quality": "pnpm run build && pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run coverage && pnpm run frontend:build && pnpm run frontend:typecheck && pnpm run frontend:lint && pnpm run frontend:test && pnpm run frontend:coverage && pnpm run go:vet && pnpm run go:vuln && pnpm run go:coverage && pnpm run go:lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck"
  },
  "dependencies": {
    "axios": "^1.18.0",
    "react-router-dom": "^7.18.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.56.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^3.2.6",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.1",
    "turbo": "^2.7.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vitest": "^3.2.6"
  }
}
