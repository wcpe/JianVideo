# JianVideo 环境变量模板 —— 复制为 deploy/.env 后填入真实值。
# .env 严禁入库（见 .gitignore）；密钥经此文件 / Secret 注入，不硬编码、不进日志。
#
# 与 compose 约定：容器内数据根为 /data，库文件默认 /data/jianvideo.db。

# ---- 监听 ----
# 宿主机映射端口（compose ports 左侧）
SERVER_PORT=8080

# ---- 数据目录（容器内路径；命名卷挂载到 /data）----
DB_PATH=/data/jianvideo.db

# ---- 安全（生产必填）----
# JWT 签名密钥：生成高强度随机值，例如 `openssl rand -base64 48`
JWT_SECRET=
# SMB 凭据加密主密码（使用 SMB 功能时必填；未设置则 SMB 凭据 API 返回 503）
SMB_MASTER_PASSWORD=

# ---- 外部工具（镜像内默认已装 ffmpeg，一般无需覆盖）----
# FFMPEG_PATH=/usr/bin/ffmpeg
# FFPROBE_PATH=/usr/bin/ffprobe

# ---- 调试（可选）----
# JIANVIDEO_DEBUG=0
